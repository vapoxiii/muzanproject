# Copie ce fichier en .env pour développer avec un compte Supabase.
# Sans ces deux valeurs, l'app fonctionne entièrement en local (pas de compte).
# Valeurs : Supabase → Project Settings → API (URL du projet et clé « anon » / publishable).
# La clé anon est publique par nature : elle est visible dans l'app, la sécurité vient des règles RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
